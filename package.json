{
  "name": "ai-knowledge-decision-assistant",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev:web": "npm --workspace @akda/web run dev",
    "dev:api": "npm --workspace @akda/api run start:dev",
    "build": "npm --workspace @akda/api run build && npm --workspace @akda/web run build",
    "test": "npm --workspace @akda/api test && npm --workspace @akda/web test",
    "seed:fixtures": "node sample-data/generate-fixtures.mjs"
  }
}
