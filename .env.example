# ============================================================
# AI Knowledge & Decision Assistant — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# --- Application ---
NODE_ENV=production
PORT=3000
MOCK_AI=false

# --- Database: Neon PostgreSQL (free tier) ---
# Get from: Neon Console → Branch → Connect → Connection string
# Format: postgresql://user:password@host/neondb?sslmode=require&channel_binding=require
DATABASE_URL=

# --- Auth ---
# Generate with PowerShell:
#   $rng=[System.Security.Cryptography.RandomNumberGenerator]::Create()
#   $bytes=New-Object byte[] 48; $rng.GetBytes($bytes)
#   [System.Convert]::ToBase64String($bytes)
JWT_SECRET=

# --- AI Providers ---
# Primary: Google Gemini (AI Studio free tier — 15 RPM, 1500 RPD)
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional fallback LLM: Groq (free developer tier)
# Get key at: https://console.groq.com
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Provider selection
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# --- AI Service (internal — do not change for combined Docker deployment) ---
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000

# --- Object Storage: Neon S3-compatible (free allowance) ---
# Get from: Neon Console → Branch → Storage → Generate credential
STORAGE_ENDPOINT=https://<branch-id>.storage.<region>.aws.neon.tech
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_NAME=
STORAGE_REGION=us-east-2

# --- URLs ---
# Production frontend URL (from Vercel)
FRONTEND_URL=https://web-beige-nu-95.vercel.app
# Production backend URL (from Render — set after first deploy)
BACKEND_URL=

# Allow these origins to call the API (comma-separated)
WEB_ORIGIN=https://web-beige-nu-95.vercel.app

# Frontend: API base URL (injected at Vite build time — public, no secrets!)
VITE_API_URL=http://localhost:3000/api/v1

# --- Rate Limiting / Usage Protection ---
MAX_CONTEXT_CHUNKS=5
MAX_OUTPUT_TOKENS=1024
MAX_QUESTION_CHARS=1000
