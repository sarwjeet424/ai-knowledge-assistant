# ============================================================
# AI Knowledge & Decision Assistant — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# --- Application ---
NODE_ENV=production
PORT=3000
MOCK_AI=false

# --- Database: Neon PostgreSQL (free tier) ---
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=

# --- AI Providers ---
# Primary: Google Gemini (AI Studio free tier)
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional fallback: Groq (free developer tier)
# Get key at: https://console.groq.com
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.1-70b-versatile

# Provider selection
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# --- AI Service (internal) ---
# In combined Docker deployment: http://localhost:8000
# In separate deployment: full URL to FastAPI service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000

# --- Cloudflare R2 Object Storage (free allowance) ---
# Create bucket at: https://dash.cloudflare.com → R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# --- URLs ---
# Production frontend URL (from Vercel)
FRONTEND_URL=
# Production backend URL (from Render)
BACKEND_URL=

# Allow these origins to call the API (comma-separated)
WEB_ORIGIN=http://localhost:5173

# Frontend: API base URL (injected at build time)
# Never put secrets in VITE_ variables — they are public
VITE_API_URL=http://localhost:3000/api/v1

# --- Rate Limiting / Usage Protection ---
MAX_CONTEXT_CHUNKS=5
MAX_OUTPUT_TOKENS=1024
MAX_QUESTION_CHARS=1000
